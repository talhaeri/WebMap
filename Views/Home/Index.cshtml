@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/@@geoman-io/leaflet-geoman-free@@2.20.0/dist/leaflet-geoman.css" />
<link rel="stylesheet" href="https://unpkg.com/gridjs@6.2.0/dist/theme/mermaid.min.css" />
<link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />

<div class="map-wrapper">
    <div class="toolbar">
        <select id="proje-sec" class="proje-sec" title="Proje sec"></select>
        <button type="button" class="toolbar-btn" data-tur="Proje" title="Yeni Proje Alani Ciz">
            <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 9 L10 3 L17 9 V17 H3 Z" fill="none" stroke="#3388ff" stroke-width="2" stroke-dasharray="3,2" /></svg>
        </button>
        <button type="button" class="toolbar-btn" id="proje-kapat-btn" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 3 L17 17 M17 3 L3 17" stroke="#e74c3c" stroke-width="2" /></svg>
        </button>
        <button type="button" class="toolbar-btn" id="proje-rapor-btn" title="Maliyet Raporu" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20">
                <path d="M4 4h12M4 8h12M4 12h8M4 16h10" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>

        <span class="toolbar-ayrac"></span>

        <button type="button" class="toolbar-btn" data-tur="Menhol" title="Menhol" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="7" fill="saddlebrown" /></svg>
        </button>
        <button type="button" class="toolbar-btn" data-tur="Kabin" title="Kabin" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><rect x="3" y="3" width="14" height="14" fill="cyan" /></svg>
        </button>
        <button type="button" class="toolbar-btn" data-tur="Santral" title="Santral" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><rect x="4" y="4" width="12" height="12" fill="#9b59b6" transform="rotate(45 10 10)" /></svg>
        </button>
        <button type="button" class="toolbar-btn" data-tur="Konut" title="Konut" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 9 L10 3 L17 9 V17 H3 Z" fill="#2ecc71" /></svg>
        </button>
        <button type="button" class="toolbar-btn" data-tur="Fiber" title="Fiber" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20"><line x1="3" y1="17" x2="17" y2="3" stroke="#e74c3c" stroke-width="2" /><circle cx="3" cy="17" r="2.5" fill="#e74c3c" /><circle cx="17" cy="3" r="2.5" fill="#e74c3c" /></svg>
        </button>

        <span class="toolbar-ayrac"></span>

        @if (User.IsInRole(WebMap.Models.Yetkiler.Yonetici))
        {
            <a class="toolbar-btn" href="/Kullanicilar" title="Kullanicilar">
                <svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="7" r="3.2" fill="#44515f" /><path d="M4 17c0-3.3 2.7-5 6-5s6 1.7 6 5" fill="none" stroke="#44515f" stroke-width="2" /></svg>
            </a>
        }

        @* Cikis bir baglanti degil form POST u: GET olsaydi sayfaya dusen bir
           resim etiketi bile kullaniciyi dusurebilirdi. *@
        <form method="post" asp-controller="Hesap" asp-action="Cikis" class="toolbar-form">
            <button type="submit" class="toolbar-btn" title="Cikis (@User.Identity?.Name)">
                <svg viewBox="0 0 20 20" width="20" height="20"><path d="M8 3H4v14h4M12 7l3 3-3 3M15 10H8" fill="none" stroke="#e74c3c" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
        </form>
    </div>

    <div id="map" data-yetki="@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value"></div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="">
    </script>
    <script src="https://unpkg.com/@@geoman-io/leaflet-geoman-free@@2.20.0/dist/leaflet-geoman.min.js"></script>
    <script src="https://unpkg.com/wellknown@0.5.0/wellknown.js"></script>
    <script src="https://unpkg.com/notiflix@3.2.8/dist/notiflix-aio-3.2.8.min.js"></script>
    <script src="https://unpkg.com/gridjs@6.2.0/dist/gridjs.umd.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}
